# Copy this file to .env in the same folder (project root, next to index.php).
# .env is gitignored. XAMPP/Apache often does not load Windows User env vars into PHP;
# this file is loaded at startup via index.php so getenv() works.

# Public site URL (no trailing slash). CodeIgniter site_url() / base_url() use this; if unset, the app guesses
# from $_SERVER (often wrong behind proxies or for subfolders — always set on production).
# Production (Hostinger: public_html/cp/):
# BASE_URL=https://superfinelabels.in/cp
# Local XAMPP (folder htdocs/cp):
# BASE_URL=http://localhost:8080/cp
BASE_URL=

# MariaDB (matches application/config/database.php). XAMPP: 127.0.0.1 when my.ini uses bind-address=127.0.0.1
CI_DB_HOST=127.0.0.1
CI_DB_USER=root
CI_DB_PASS=
CI_DB_NAME=property
CI_DB_PORT=3306

# Browser key: Maps JavaScript API + Places API enabled in Google Cloud.
GOOGLE_MAPS_API_KEY=

# AskEva WhatsApp OTP (template: authentication). Or use application/config/whatsapp.local.php
ASKEVA_API_KEY=

# Admin notification inbox (KYC, listings, enquiries)
NB_ADMIN_EMAIL=admin@dreamvillamakers.com

# Outbound mail. On Hostinger use a mailbox on the domain (not noreply@localhost).
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_CRYPTO=ssl
# SMTP_USER=your-mailbox@yourdomain.com
# SMTP_PASS=
# NB_MAIL_FROM=your-mailbox@yourdomain.com

